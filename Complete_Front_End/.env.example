# Node.js API
PORT=3001
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
AUTH_TOKEN_TTL_SECONDS=28800

# Neon PostgreSQL connection string. When omitted locally, the JSON database is used.
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Used only when the backend creates its database for the first time.
ADMIN_EMAIL=admin@navana.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator

# Only needed when the browser and API are deployed on different origins.
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: override the local server/data/database.json location.
# DATA_FILE=D:/path/to/database.json

# Optional: use an absolute API URL instead of the Vite /api proxy.
# VITE_API_URL=http://localhost:3001/api
