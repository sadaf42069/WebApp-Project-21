{
  "name": "navana-bailey-star-management-system",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/tests/api.test.js server/tests/postgres-database.test.js && node --experimental-strip-types --test src/tests/routing.test.ts",
    "test:api": "node --test server/tests/api.test.js server/tests/postgres-database.test.js",
    "test:frontend": "node --experimental-strip-types --test src/tests/routing.test.ts",
    "test:postgres": "node server/tests/postgres-smoke.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
